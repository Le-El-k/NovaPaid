# Public runtime configuration. Copy to .env.local and fill in your own values.
# Never commit .env.local or provider secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:4174
NEXT_PUBLIC_SOLEASPAY_API_KEY=
# SoleasPay webhook security (SERVER-SIDE ONLY — keep in .env.local or a secret).
# Point your SoleasPay notification URL to: <site>/api/webhooks/soleaspay
# The webhook verifies the x-private-key header = sha256(SOLEASPAY_WEBHOOK_TOKEN).
SOLEASPAY_WEBHOOK_TOKEN=
# Optional but recommended: gateway app token (Bearer) so the webhook re-checks
# each payment via the Collection Status API before crediting.
SOLEASPAY_GATEWAY_TOKEN=
NEXT_PUBLIC_MAILJET_PROXY_URL=https://nova-pay-mailjet.your-account.workers.dev/api/mailjet

# Mailjet transactional email for verification codes (SERVER-SIDE ONLY).
# Put the real values in .env.mailjet.local (git-ignored). The sender must be a
# validated sender/domain in your Mailjet account or delivery will fail.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=support@novapaid.net
MAILJET_FROM_NAME=NovaPaid
# Optional validated fallback sender, used only if the branded sender is rejected.
MAILJET_FALLBACK_FROM_EMAIL=

# Initial administrator bootstrap (keep the real password in .env.admin.local or deployment secrets)
NOVAPAID_BOOTSTRAP_ADMIN_EMAIL=service@novapaid.net
NOVAPAID_BOOTSTRAP_ADMIN_PASSWORD=


# Geny partner API (Connexion internet). SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix,
# never expose it to the browser. Put the real key in .env.geny.local (git-ignored)
# or a deployment secret. Test key = gk_test_…, live key = gk_live_…
GENY_API_KEY=
# GENY_API_BASE=https://geny.payool.net/api/v1/partner/

# Cloudflare Worker URLs used by the payment proxies.
NEXT_PUBLIC_LEEKPAY_PROXY_URL=https://nova-pay-leekpay.sebpay-proxy.workers.dev/api/leekpay
NEXT_PUBLIC_SEBPAY_PROXY_URL=https://nova-pay-sebpay.sebpay-proxy.workers.dev/api/sebpay

# Maplerad — virtual Visa cards & bank accounts. SERVER-SIDE ONLY (no NEXT_PUBLIC_).
# Put the real keys in .env.maplerad.local (git-ignored) or a deployment secret.
# The same host serves sandbox & production; the environment is chosen by the key.
MAPLERAD_PUBLIC_KEY=
MAPLERAD_SECRET_KEY=
MAPLERAD_ENVIRONMENT=sandbox
# MAPLERAD_BASE_URL=https://api.maplerad.com/v1
# MAPLERAD_TIMEOUT_MS=20000
# Webhook signing secret from the Maplerad dashboard (format whsec_...).
MAPLERAD_WEBHOOK_SECRET=
